PLANE_BASE_URL=https://ticket.frigate.ai
PLANE_API_KEY=plane_api_xxx
PLANE_WORKSPACE_SLUG=your-workspace-slug

# Public HTTPS URL of this connector (the OAuth issuer)
SERVER_URL=https://mcp.frigate.ai
# Password you type on the sign-in page when ChatGPT connects
OAUTH_LOGIN_PASSWORD=change-me-to-a-long-random-string
# Optional static bearer token for curl/testing; leave empty to disable
MCP_AUTH_TOKEN=
# Where OAuth clients/tokens are persisted (mount a volume here)
DATA_DIR=/data
PORT=3000
